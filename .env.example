# ---------------------------------------------------------------------------
# Cairn environment
# Copy to `.env` and fill in. Never commit `.env`.
# ---------------------------------------------------------------------------

# PostgreSQL connection string (Neon in production, local Postgres in dev).
DATABASE_URL="postgresql://user:password@localhost:5432/cairn?schema=public"

# Auth.js. Generate a secret with:  npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET="replace-me-with-a-long-random-string"

# Base URL of the app. Required in production; optional in dev.
# AUTH_URL="https://cairn.example.org"

# Only addresses ending in this domain may sign in.
ALLOWED_EMAIL_DOMAIN="navigators.org"

# ---- Magic-link email delivery ----------------------------------------------
# Leave EMAIL_SERVER unset in development: sign-in links are printed to the
# server console instead of being emailed, so you can sign in with no SMTP setup.
# In production set an SMTP URL, e.g. smtp://user:pass@smtp.host:587
# EMAIL_SERVER="smtp://user:pass@smtp.host:587"
EMAIL_FROM="Cairn <no-reply@cairn.local>"
